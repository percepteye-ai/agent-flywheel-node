{
  "name": "percepteye-agent-flywheel",
  "version": "0.1.0",
  "description": "Close the loop on your OpenClaw or DeepSeek Harness agent: record what your tools actually did — ok, failed or unknown — into the trajectory the PerceptEye flywheel trains on. Observes only; never alters a tool result.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./classify": "./src/classify.js",
    "./trajectory": "./src/trajectory.js",
    "./dsh": "./src/dsh.js"
  },
  "files": [
    "src",
    "schema",
    "openclaw.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "dsh-plugin",
    "deepseek-harness",
    "percepteye",
    "agent",
    "reinforcement-learning",
    "continual-learning",
    "observability"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/percepteye-ai/agent-flywheel-node.git"
  },
  "homepage": "https://github.com/percepteye-ai/agent-flywheel-node",
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.js"
  },
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bugs": {
    "url": "https://github.com/percepteye-ai/agent-flywheel-node/issues"
  }
}
