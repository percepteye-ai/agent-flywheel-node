{
  "name": "@percepteye/agent-flywheel",
  "version": "0.5.0",
  "description": "Agent Flywheel for JavaScript and TypeScript agents: capture the turns your agent serves, run the graded training rollouts your control plane sends, and apply the system prompt and model a person approved. Works with any framework (Vercel AI SDK, LangChain.js, LangGraph.js, Mastra, the OpenAI SDK or plain code) through one import, and loads as a plugin into OpenClaw and DeepSeek Harness. Never alters a tool result. Zero runtime dependencies.",
  "license": "MIT",
  "author": "PerceptEye",
  "type": "module",
  "main": "./src/index.js",
  "types": "./types/index.d.ts",
  "bin": {
    "agent-flywheel": "src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./src/index.js"
    },
    "./ai-sdk": {
      "types": "./types/ai-sdk.d.ts",
      "default": "./src/adapters/ai-sdk.js"
    },
    "./langchain": {
      "types": "./types/langchain.d.ts",
      "default": "./src/adapters/langchain.js"
    },
    "./classify": "./src/classify.js",
    "./trajectory": "./src/trajectory.js",
    "./dsh": "./src/dsh.js",
    "./tracing": "./src/tracing.js",
    "./customer-api": "./src/customer-api.js"
  },
  "files": [
    "src",
    "schema",
    "types",
    "openclaw.plugin.json",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "dsh-plugin",
    "deepseek-harness",
    "percepteye",
    "agent",
    "reinforcement-learning",
    "continual-learning",
    "observability",
    "typescript",
    "vercel-ai-sdk",
    "ai-sdk",
    "langchain",
    "langgraph",
    "mastra",
    "llm",
    "agents"
  ],
  "engines": {
    "node": ">=22.22.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/percepteye-ai/agent-flywheel-node.git"
  },
  "homepage": "https://github.com/percepteye-ai/agent-flywheel-node",
  "scripts": {
    "test": "node --test --test-timeout=30000 test/*.test.js"
  },
  "openclaw": {
    "extensions": [
      "./src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1"
    },
    "build": {
      "openclawVersion": "2026.7.1"
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bugs": {
    "url": "https://github.com/percepteye-ai/agent-flywheel-node/issues"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
